@theme {
  /* used via utility-classes, bg-background, text-primary, and many more */
  --color-background: #07060f;
  --color-foreground: #f0eeff;
  --color-border: #2a2440;
  --color-input: #13102a;
  --color-primary: #a855f7;
  --color-primary-foreground: #ffffff;
  --color-secondary: #ec4899;
  --color-secondary-foreground: #ffffff;
  --color-muted: #1a1630;
  --color-muted-foreground: #7c6f9e;
  --color-accent: #06b6d4;
  --color-accent-foreground: #ffffff;
  --color-glass: rgba(255,255,255,0.04);
  --color-glass-border: rgba(168,85,247,0.2);
  --color-glow-violet: rgba(168,85,247,0.35);
  --color-glow-pink: rgba(236,72,153,0.3);
  --color-surface: #0f0c1f;
  --color-surface-foreground: #c8b8f0;

  /* DO NOT REMOVE: these radius variables are required by the theme editor. */
  --radius-sm: 6px;
  --radius-md: 12px;
  --radius-lg: 18px;
  --radius-xl: 28px;

  /* DONT CHANGE OR REMOVE THIS VARIABLE */
  --radius: var(--radius-sm);

  /* DO NOT REMOVE: these font variables are required by the theme editor. */
  /* available fonts: "Inter", "DM Sans", "Nunito", "PT Serif", "Space Grotesk", "IBM Plex Mono", "IBM Plex Sans", "Roboto Slab", "Geist", "Shantell Sans" */
  --font-body: Inter;
  --font-headings: Space Grotesk;

  /* Add and change text sizes as you see fit */
  --text-xs: 11px;
  --text-sm: 13px;
  --text-base: 15px;
  --text-lg: 18px;
  --text-xl: 22px;
  --text-2xl: 28px;
  --text-3xl: 38px;
  --text-4xl: 52px;
  --text-5xl: 70px;
}
